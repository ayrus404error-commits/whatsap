<?xml version="1.0" encoding="utf-8"?>
<!-- "Custom" app icon: replace res/drawable-nodpi/chat_icon_custom.png with your own
     square PNG (432 x 432 px is ideal). The whole picture is shown (not zoomed):
     it sits in the visible middle, on a stretched copy of itself so the edges match. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/chat_icon_custom" />
    <foreground android:drawable="@drawable/chat_icon_custom_fit" />
</adaptive-icon>
